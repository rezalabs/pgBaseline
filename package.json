{
  "name": "pgbaseline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A starting configuration for your PostgreSQL server, from your version, operating system, workload, and hardware, with the documentation behind every value.",
  "license": "MIT",
  "author": {
    "name": "RezaLabs",
    "url": "https://rezalabs.com"
  },
  "homepage": "https://rezalabs.github.io/pgBaseline/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rezalabs/pgBaseline.git"
  },
  "bugs": {
    "url": "https://github.com/rezalabs/pgBaseline/issues"
  },
  "funding": "https://ko-fi.com/rezalabs",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "knip": "^6.49.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
